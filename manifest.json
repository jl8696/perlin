{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.27/MicrosoftTeams.schema.json",
  "manifestVersion": "1.27",
  "version": "1.0.0",
  "id": "38f0f113-acff-47b1-9689-bdce5be200e6",
  "localizationInfo": {
    "defaultLanguageTag": "en-us"
  },
  "developer": {
    "name": "Particle Background",
    "websiteUrl": "https://www.contoso.com",
    "privacyUrl": "https://www.contoso.com/privacy",
    "termsOfUseUrl": "https://www.contoso.com/terms"
  },
  "name": {
    "short": "Particle Background",
    "full": "Live Particle Background for PowerPoint"
  },
  "description": {
    "short": "A live p5.js particle background for PowerPoint.",
    "full": "Displays a continuous p5.js particle animation inside a PowerPoint slide."
  },
  "icons": {
    "outline": "assets/icon-32.png",
    "color": "assets/icon-192.png"
  },
  "accentColor": "#FFFFFF",
  "validDomains": [
    "localhost"
  ],
  "authorization": {
    "permissions": {}
  },
  "extensions": [
    {
      "requirements": {
        "scopes": [ "presentation" ],
        "capabilities": [
          {
            "name": "PowerPointApi",
            "minVersion": "1.1"
          }
        ]
      },
      "contentRuntimes": [
        {
          "id": "ContentRuntime",
          "code": {
            "page": "https://localhost:3000/content.html"
          },
          "requestedWidth": 960,
          "requestedHeight": 540,
          "disableSnapshot": true
        }
      ]
    }
  ]
}
